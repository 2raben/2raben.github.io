---
/**
 * Car Drive's road as a comic chart: the levels along the distance, when the
 * traffic changes, and what helps on the way. Facts from
 * src/content/games/car-drive.md.
 */
import Icon from "./Icon.astro";

const ink = "#111111";
const scale = 170; // pixels per 1000 m
const start = 70;
const x = (meters: number) => start + (meters / 1000) * scale;
const marks = [0, 1000, 2000, 3000, 4000, 5000];
const lanes = [92, 142, 192];
/** Cars on the chart: position in meters, lane, and direction. */
const cars: { m: number; lane: number; dir: 1 | -1; truck?: boolean }[] = [
  { m: 350, lane: 0, dir: 1 },
  { m: 650, lane: 2, dir: -1 },
  { m: 1300, lane: 1, dir: 1 },
  { m: 1650, lane: 2, dir: -1 },
  { m: 2300, lane: 0, dir: -1 },
  { m: 2650, lane: 1, dir: 1 },
  { m: 3200, lane: 2, dir: 1 },
  { m: 3550, lane: 0, dir: -1 },
  { m: 4300, lane: 1, dir: -1, truck: true },
  { m: 4650, lane: 2, dir: 1, truck: true },
];
const helpers = [
  {
    icon: "heart",
    title: "3 Herzen",
    text: "Ein Treffer kostet ein Herz, danach bist du kurz geschützt.",
  },
  {
    icon: "shield",
    title: "Herz oder Schild",
    text: "Liegt selten auf der Strasse.",
  },
  {
    icon: "coin",
    title: "Münzen",
    text: "Alle 10 Meter verdienst du eine.",
  },
  {
    icon: "garage",
    title: "Garage",
    text: "Andere Autos, Farben, Reifen und Motor-Upgrades.",
  },
] as const;
---

<section aria-labelledby="road-title" class="flex flex-col gap-8">
  <h2 id="road-title" class="comic-title text-5xl text-pop-yellow sm:text-6xl">
    Die Strecke
  </h2>
  <figure class="panel overflow-hidden" style="--panel-rot: -0.5deg">
    <div class="overflow-x-auto">
      <svg
        viewBox="0 0 1000 300"
        class="min-w-[720px]"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-labelledby="road-desc"
      >
        <desc id="road-desc">
          Eine Strasse mit drei Spuren. Alle 1000 Meter beginnt ein neues Level.
          Ab Level 3, nach 2000 Metern, fahren auf jeder Spur Autos in beide
          Richtungen. Ab 4000 Metern kommen Lastwagen dazu.
        </desc>
        <rect x="0" y="0" width="1000" height="300" fill="#2a9d8f"></rect>
        <rect x="0" y="66" width="1000" height="152" fill="#4a4e69"></rect>
        <path
          d="M 0 66 H 1000 M 0 218 H 1000"
          stroke={ink}
          stroke-width="5"
        ></path>
        <path
          d="M 0 117 H 1000 M 0 167 H 1000"
          stroke="#ffffff"
          stroke-width="4"
          stroke-dasharray="24 18"
        ></path>
        <rect
          x={x(2000)}
          y="66"
          width={x(5000) - x(2000) + 40}
          height="152"
          fill="#d62828"
          opacity="0.18"
        ></rect>
        {marks.map((m, i) => (
          <g>
            <path
              d={`M ${x(m)} 58 V 226`}
              stroke={ink}
              stroke-width="3"
              stroke-dasharray="6 6"
            />
            <rect
              x={x(m) - 44}
              y="234"
              width="88"
              height="30"
              fill="#ffffff"
              stroke={ink}
              stroke-width="3"
            />
            <text
              x={x(m)}
              y="257"
              text-anchor="middle"
              font-family="Bangers, Impact, sans-serif"
              font-size="22"
              fill={ink}
            >
              {m} m
            </text>
            {i < marks.length - 1 && (
              <text
                x={x(m) + scale / 2}
                y="44"
                text-anchor="middle"
                font-family="Bangers, Impact, sans-serif"
                font-size="26"
                fill="#ffd60a"
                stroke={ink}
                stroke-width="4"
                paint-order="stroke"
              >
                Level {i + 1}
              </text>
            )}
          </g>
        ))}
        {cars.map((car) => {
          const cx = x(car.m);
          const cy = lanes[car.lane] ?? 142;
          const w = car.truck ? 70 : 46;
          return (
            <g>
              <rect
                x={cx - w / 2}
                y={cy - 15}
                width={w}
                height="30"
                rx="6"
                fill={
                  car.truck ? "#ff9f1c" : car.dir === 1 ? "#ffffff" : "#ff4fa3"
                }
                stroke={ink}
                stroke-width="3"
              />
              <path
                d={
                  car.dir === 1
                    ? `M ${cx - 10} ${cy} H ${cx + 8} M ${cx + 2} ${cy - 6} L ${cx + 9} ${cy} L ${cx + 2} ${cy + 6}`
                    : `M ${cx + 10} ${cy} H ${cx - 8} M ${cx - 2} ${cy - 6} L ${cx - 9} ${cy} L ${cx - 2} ${cy + 6}`
                }
                fill="none"
                stroke={ink}
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </g>
          );
        })}
        <g>
          <rect
            x="14"
            y="127"
            width="50"
            height="30"
            rx="6"
            fill="#00b4d8"
            stroke={ink}
            stroke-width="4"
          ></rect>
          <path d="M 50 130 V 154" stroke={ink} stroke-width="3"></path>
          <path
            d="M 6 132 H -10 M 6 152 H -6"
            stroke={ink}
            stroke-width="3"
            stroke-linecap="round"
          ></path>
        </g>
        <g font-family="Bangers, Impact, sans-serif" font-size="20">
          <rect
            x={x(2000) + 8}
            y="274"
            width="320"
            height="24"
            fill="#ffd60a"
            stroke={ink}
            stroke-width="2"
          ></rect>
          <text x={x(2000) + 16} y="292" fill={ink}>
            Ab Level 3: beide Richtungen auf jeder Spur
          </text>
        </g>
        <g transform={`translate(${x(4000) + 12} 230)`}>
          <rect
            x="-4"
            y="44"
            width="180"
            height="26"
            fill="#ff9f1c"
            stroke={ink}
            stroke-width="2"
          ></rect>
          <text
            x="4"
            y="64"
            font-family="Bangers, Impact, sans-serif"
            font-size="20"
            fill={ink}
          >
            Ab 4000 m: Lastwagen
          </text>
        </g>
      </svg>
    </div>
    <p class="border-t-4 border-ink bg-pop-yellow px-4 py-1 text-sm font-semibold sm:hidden">
      Wischen für die ganze Strecke →
    </p>
    <figcaption class="flex flex-wrap gap-4 border-t-4 border-ink p-4 text-sm">
      <span class="flex items-center gap-2">
        <span class="h-4 w-6 rounded border-2 border-ink bg-white"></span> in
        deiner Richtung: holst du langsam ein
      </span>
      <span class="flex items-center gap-2">
        <span class="h-4 w-6 rounded border-2 border-ink bg-pop-pink"></span>{" "}
        Gegenverkehr: kommt schnell auf dich zu
      </span>
      <span class="flex items-center gap-2">
        <span class="h-4 w-6 rounded border-2 border-ink bg-pop-cyan"></span> du
      </span>
    </figcaption>
  </figure>
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {helpers.map((helper, i) => (
      <li
        class="panel flex flex-col items-center gap-2 p-4 text-center"
        style={`--panel-rot: ${i % 2 ? 1 : -1}deg`}
        data-tilt
      >
        <Icon name={helper.icon} class="h-16 w-16" />
        <span class="panel-caption">{helper.title}</span>
        <span>{helper.text}</span>
      </li>
    ))}
  </ul>
</section>
