---
/**
 * The ram's head, for use inside Ram.astro's <svg>. It is drawn around (0, 0),
 * about 150 units wide with the horns. The pupils (class "ram-pupil") follow
 * the pointer through effects.ts.
 */
interface Props {
  x: number;
  y: number;
  scale?: number;
  rotate?: number;
  /** Which way the mask's ribbons fly: away from the direction of travel. */
  tails?: "left" | "right";
  tongue?: boolean;
}

const {
  x,
  y,
  scale = 1,
  rotate = 0,
  tails = "right",
  tongue = false,
} = Astro.props;
const ink = "#111111";
const face = "#3a2b2b";
const horn =
  "M -14 -30 C -40 -50 -72 -32 -68 -2 C -65 22 -36 26 -32 6 C -29 -6 -44 -11 -48 -1";
const tailFlip = tails === "left" ? "scale(-1 1)" : "";
---

<g
  class="ram-head"
  transform={`translate(${x} ${y}) rotate(${rotate}) scale(${scale})`}
>
  <g transform={tailFlip}>
    <g class="mask-tails">
      <path
        d="M 28 -6 C 48 -14 62 -2 82 -12 L 80 0 C 62 8 48 0 30 6 Z"
        fill="#d62828"
        stroke={ink}
        stroke-width="3"
        stroke-linejoin="round"
      ></path>
      <path
        d="M 28 2 C 44 4 56 18 74 14 L 70 25 C 52 28 42 14 28 10 Z"
        fill="#d62828"
        stroke={ink}
        stroke-width="3"
        stroke-linejoin="round"
      ></path>
    </g>
  </g>
  <ellipse
    cx="-41"
    cy="8"
    rx="17"
    ry="8"
    transform="rotate(-22 -41 8)"
    fill={face}
    stroke={ink}
    stroke-width="4"
  ></ellipse>
  <ellipse
    cx="41"
    cy="8"
    rx="17"
    ry="8"
    transform="rotate(22 41 8)"
    fill={face}
    stroke={ink}
    stroke-width="4"
  ></ellipse>
  <g>
    <path
      d={horn}
      fill="none"
      stroke={ink}
      stroke-width="15"
      stroke-linecap="round"
    ></path>
    <path
      d={horn}
      fill="none"
      stroke="#f4c95d"
      stroke-width="8"
      stroke-linecap="round"
    ></path>
    <g transform="scale(-1 1)">
      <path
        d={horn}
        fill="none"
        stroke={ink}
        stroke-width="15"
        stroke-linecap="round"
      ></path>
      <path
        d={horn}
        fill="none"
        stroke="#f4c95d"
        stroke-width="8"
        stroke-linecap="round"
      ></path>
    </g>
  </g>
  <path
    d="M -28 -10 C -30 -42 30 -42 28 -10 L 24 30 C 20 52 -20 52 -24 30 Z"
    fill={face}
    stroke={ink}
    stroke-width="4"
    stroke-linejoin="round"
  ></path>
  <ellipse cx="0" cy="34" rx="18" ry="13" fill="#5c4741"></ellipse>
  <ellipse cx="-6" cy="31" rx="2.6" ry="3.6" fill={ink}></ellipse>
  <ellipse cx="6" cy="31" rx="2.6" ry="3.6" fill={ink}></ellipse>
  <path
    d="M -9 40 Q 0 48 9 40"
    fill="none"
    stroke="#f3d2c1"
    stroke-width="3"
    stroke-linecap="round"
  ></path>
  {tongue && (
    <ellipse
      cx="7"
      cy="45"
      rx="4"
      ry="5"
      fill="#ff4fa3"
      stroke={ink}
      stroke-width="2"
    />
  )}
  <circle cx="-16" cy="-33" r="15" fill={ink}></circle>
  <circle cx="0" cy="-40" r="17" fill={ink}></circle>
  <circle cx="16" cy="-33" r="15" fill={ink}></circle>
  <circle cx="-16" cy="-33" r="11" fill="#ffffff"></circle>
  <circle cx="0" cy="-40" r="13" fill="#ffffff"></circle>
  <circle cx="16" cy="-33" r="11" fill="#ffffff"></circle>
  <path
    d="M -33 -9 Q 0 -18 33 -9 L 32 11 Q 0 5 -32 11 Z"
    fill="#d62828"
    stroke={ink}
    stroke-width="3"
    stroke-linejoin="round"
  ></path>
  <g class="ram-eye">
    <ellipse
      cx="-13"
      cy="0"
      rx="8.5"
      ry="9.5"
      fill="#ffffff"
      stroke={ink}
      stroke-width="2.5"
    ></ellipse>
    <g class="ram-pupil" data-cx="-13" data-cy="0">
      <circle cx="-13" cy="0" r="4.4" fill={ink}></circle>
      <circle cx="-11.6" cy="-1.6" r="1.5" fill="#ffffff"></circle>
    </g>
  </g>
  <g class="ram-eye">
    <ellipse
      cx="13"
      cy="0"
      rx="8.5"
      ry="9.5"
      fill="#ffffff"
      stroke={ink}
      stroke-width="2.5"
    ></ellipse>
    <g class="ram-pupil" data-cx="13" data-cy="0">
      <circle cx="13" cy="0" r="4.4" fill={ink}></circle>
      <circle cx="14.4" cy="-1.6" r="1.5" fill="#ffffff"></circle>
    </g>
  </g>
  <path
    d="M -24 -19 L -6 -13 M 24 -19 L 6 -13"
    stroke={ink}
    stroke-width="4.5"
    stroke-linecap="round"
  ></path>
</g>
