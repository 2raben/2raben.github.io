    {(pose === "landing" || pose === "sketch") && (
      <g>
        <g fill={ink}>
          {body.map((b) => (
            <circle cx={b.x} cy={b.y} r={b.r + 4} />
          ))}
        </g>
        <g fill="#ffffff">
          {body.map((b) => (
            <circle cx={b.x} cy={b.y} r={b.r} />
