        ))}
        <path
          d="M -88 165 L -24 122 L 52 122 L 92 165"
          fill="none"
          stroke={ink}
          stroke-width="9"
          stroke-linejoin="round"
        />
        <path
          d="M 92 165 L 62 92"
          stroke={ink}
          stroke-width="8"
          stroke-linecap="round"
        />
        <path
          d="M -44 112 L 40 104 L 64 124 L -34 132 Z"
          fill={red}
          stroke={ink}
