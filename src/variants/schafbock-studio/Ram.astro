        </g>
      </g>
    )}

    {pose === "landing" && (
      <g>
        <circle
          cx="0"
          cy="98"
          r="16"
          fill="#ffd60a"
          stroke={ink}
          stroke-width="3.5"
        />
        <path
          d="M 0 98 m -5 0 a 5 5 0 1 1 7 4 a 9 9 0 1 1 -11 -9"
          fill="none"
          stroke={ink}
          stroke-width="2.5"
          stroke-linecap="round"
        />
        {[-1, 1].map((side) => (
          <g transform={`scale(${side} 1)`}>
            <path
              d="M -38 76 Q -70 92 -46 118"
              fill="none"
              stroke={ink}
              stroke-width="16"
              stroke-linecap="round"
            />
            <path
              d="M -38 76 Q -70 92 -46 118"
              fill="none"
              stroke={fur}
              stroke-width="9"
              stroke-linecap="round"
            />
            <circle cx="-46" cy="118" r="8" fill={ink} />
          </g>
        ))}
        <RamHead x={0} y={20} />
      </g>
    )}

    {pose === "sketch" && (
      <g>
        <g transform="rotate(-7 -10 106)">
          <rect
            x="-74"
            y="62"
            width="128"
            height="96"
            rx="4"
            fill="#ffffff"
            stroke={ink}
            stroke-width="4"
