          <g fill="#ffffff" stroke={ink} stroke-width="2.5">
            {[-60, -44, -28, -12, 4, 20, 36].map((x) => (
              <circle cx={x} cy="62" r="4" />
            ))}
          </g>
          <g
            fill="none"
            stroke="#1d4ed8"
            stroke-width="2.5"
            stroke-linecap="round"
          >
            <circle cx="-52" cy="118" r="10" />
            <circle cx="-18" cy="118" r="10" />
            <path d="M -52 118 L -38 102 L -22 102 L -18 118 M -30 102 L -28 92" />
            <path d="M 0 124 L 0 108 L 10 100 L 34 100 L 42 110 L 42 124 Z" />
            <circle cx="10" cy="126" r="6" />
            <circle cx="34" cy="126" r="6" />
            <path d="M -60 140 Q -40 132 -20 140 T 20 140 T 44 138" />
