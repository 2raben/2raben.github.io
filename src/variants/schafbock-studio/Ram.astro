          stroke-linejoin="round"
        />
        <circle
          cx="74"
          cy="110"
          r="10"
          fill="#ffd60a"
          stroke={ink}
          stroke-width="4"
        />
        <path
          d="M -70 110 L -20 106"
          stroke={ink}
          stroke-width="11"
          stroke-linecap="round"
        />
        <g fill={ink}>
          {body.map((b) => (
            <circle cx={b.x} cy={b.y} r={b.r + 4} />
          ))}
        </g>
        <g fill="#ffffff">
          {body.map((b) => (
            <circle cx={b.x} cy={b.y} r={b.r} />
          ))}
        </g>
        <circle
          cx="-14"
          cy="80"
          r="11"
          fill="#ffd60a"
          stroke={ink}
          stroke-width="3"
        />
        <path
          d="M -14 80 m -4 0 a 4 4 0 1 1 6 3 a 7 7 0 1 1 -9 -7"
          fill="none"
          stroke={ink}
          stroke-width="2"
        />
        <path
          d="M -8 108 L 12 140 L 22 152"
          fill="none"
          stroke={ink}
          stroke-width="15"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M -8 108 L 12 140 L 22 152"
          fill="none"
          stroke={fur}
          stroke-width="8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M 10 146 l 22 0 l 0 14 l -24 0 Z"
          fill={red}
          stroke={ink}
          stroke-width="4"
          stroke-linejoin="round"
        />
        <path
          d="M 4 68 L 60 88"
          stroke={ink}
          stroke-width="15"
          stroke-linecap="round"
        />
        <path
          d="M 4 68 L 60 88"
          stroke={fur}
          stroke-width="8"
          stroke-linecap="round"
        />
        <path
          d="M 52 96 L 72 82"
          stroke={ink}
          stroke-width="8"
          stroke-linecap="round"
        />
        <RamHead x={22} y={18} scale={0.9} rotate={10} tails="left" />
      </g>
    )}

    {pose === "car" && (
      <g>
        <path
          d="M -172 120 L -150 120 M -174 140 L -156 140 M -170 160 L -150 160"
          stroke={ink}
          stroke-width="4"
          stroke-linecap="round"
        />
        <g fill={ink}>
          {body.map((b) => (
            <circle cx={b.x} cy={b.y} r={b.r + 4} />
          ))}
        </g>
        <g fill="#ffffff">
          {body.map((b) => (
            <circle cx={b.x} cy={b.y} r={b.r} />
          ))}
        </g>
        <path
          d="M 44 98 L 66 62 L 76 64 L 58 98 Z"
          fill="#cdeffd"
          stroke={ink}
          stroke-width="4"
          stroke-linejoin="round"
        />
        <path
          d="M 6 76 L 40 78"
          stroke={ink}
          stroke-width="15"
          stroke-linecap="round"
        />
        <path
          d="M 6 76 L 40 78"
          stroke={fur}
          stroke-width="8"
          stroke-linecap="round"
        />
        <ellipse
          cx="44"
          cy="80"
          rx="6"
          ry="17"
          fill="none"
          stroke={ink}
          stroke-width="5"
        />
        <path
          d="M -146 160 L -146 122 C -146 110 -136 104 -124 104 L -52 104 L -40 98 L 62 98 L 104 112 L 140 116 C 152 118 158 128 158 140 L 158 160 Z"
          fill="#00b4d8"
          stroke={ink}
          stroke-width="5"
