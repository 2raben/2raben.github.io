---
/**
 * The Schafbock, the studio's superhero ram, as an SVG drawing in one of four
 * poses. Our own drawing; it copies nothing from the games or other comics.
 *
 * - landing: just landed, hooves on hips, cracks in the ground (home page)
 * - moto: on a motorbike, popping a wheelie (Moto Devil)
 * - car: at the wheel of a convertible (Car Drive)
 * - sketch: sketching the first game ideas on paper (Über uns)
 */
import type { RamPose } from "./comics";
import RamHead from "./RamHead.astro";

interface Props {
  pose: RamPose;
  class?: string;
  /** Accessible description; omit for a purely decorative ram. */
  label?: string;
}

const { pose, class: className = "", label } = Astro.props;
const ink = "#111111";
const fur = "#3a2b2b";
const red = "#d62828";

const viewBoxes: Record<RamPose, string> = {
  landing: "-125 -95 250 300",
  moto: "-175 -50 345 255",
  car: "-175 -30 345 225",
  sketch: "-130 -100 270 310",
};

/** A woolly body: overlapping circles, first in ink, then in white. */
function wool(cx: number, cy: number, s: number) {
  const bumps: [number, number, number][] = [
    [0, 0, 44],
    [-30, -22, 22],
    [30, -22, 22],
    [-42, 4, 22],
    [42, 4, 22],
    [-28, 30, 22],
    [28, 30, 22],
    [0, 38, 24],
    [0, -32, 24],
  ];
  return bumps.map(([x, y, r]) => ({
    x: cx + x * s,
    y: cy + y * s,
    r: r * s,
  }));
}
const body = {
  landing: wool(0, 100, 1),
  sketch: wool(0, 100, 1),
  moto: wool(-18, 84, 0.72),
  car: wool(-10, 92, 0.66),
}[pose];
---

<div class:list={["ram", className]} data-ram>
  <svg
    viewBox={viewBoxes[pose]}
    xmlns="http://www.w3.org/2000/svg"
    role={label ? "img" : undefined}
    aria-label={label}
    aria-hidden={label ? undefined : "true"}
  >
    {(pose === "landing" || pose === "sketch") && (
      <path
        class="cape"
        d="M -34 64 C -72 110 -96 160 -88 198 C -52 186 -22 202 0 192 C 32 204 72 190 104 198 C 98 150 72 100 34 64 Z"
        fill={red}
        stroke={ink}
        stroke-width="4"
        stroke-linejoin="round"
      />
    )}
    {pose === "moto" && (
      <path
        class="cape"
        d="M -4 60 C -60 36 -112 58 -168 34 C -156 66 -128 84 -160 108 C -104 112 -60 98 -16 92 Z"
        fill={red}
        stroke={ink}
        stroke-width="4"
        stroke-linejoin="round"
      />
    )}
    {pose === "car" && (
      <path
        class="cape"
        d="M -6 62 C -60 40 -110 60 -168 40 C -158 70 -132 84 -164 104 C -110 104 -64 96 -18 92 Z"
        fill={red}
        stroke={ink}
        stroke-width="4"
        stroke-linejoin="round"
      />
    )}

    {pose === "landing" && (
      <g>
        <path
          d="M -100 -85 L -100 -40 M -70 -90 L -70 -55 M 70 -90 L 70 -50 M 100 -82 L 100 -35"
          stroke={ink}
          stroke-width="4"
          stroke-linecap="round"
          stroke-dasharray="14 9"
        />
        <path
          d="M -118 192 L 118 192"
          stroke={ink}
          stroke-width="5"
          stroke-linecap="round"
        />
        <path
          d="M -10 192 L -30 204 L -48 198 L -70 208 M 12 192 L 30 202 L 52 196 L 78 206"
          fill="none"
          stroke={ink}
          stroke-width="3.5"
          stroke-linejoin="round"
        />
        <g fill="#ffffff" stroke={ink} stroke-width="3">
          <circle cx="-72" cy="180" r="12" />
          <circle cx="-90" cy="186" r="8" />
          <circle cx="74" cy="180" r="12" />
          <circle cx="93" cy="186" r="8" />
        </g>
      </g>
