        <path d="M -146 132 L 158 132" stroke={red} stroke-width="8" />
        <path
          d="M -40 104 L -40 156 M 56 104 L 56 156"
          stroke={ink}
          stroke-width="3"
        />
        <circle
          cx="150"
          cy="124"
          r="6"
          fill="#ffd60a"
          stroke={ink}
          stroke-width="3"
        />
        <rect
          x="-152"
          y="112"
          width="10"
          height="10"
          fill={red}
          stroke={ink}
          stroke-width="3"
        />
        {[-96, 104].map((cx) => (
          <g>
            <circle cx={cx} cy="162" r="30" fill={ink} />
            <circle cx={cx} cy="162" r="17" fill="#cfd8dc" />
            <g class="wheel">
              <circle cx={cx} cy="162" r="17" fill="none" />
              <path
                d={`M ${cx - 17} 162 L ${cx + 17} 162 M ${cx} 145 L ${cx} 179`}
                stroke={ink}
                stroke-width="4"
              />
            </g>
            <circle cx={cx} cy="162" r="5" fill={ink} />
          </g>
        ))}
        <path
          d="M -175 194 L 170 194"
          stroke={ink}
          stroke-width="5"
          stroke-linecap="round"
        />
        <RamHead x={-6} y={28} scale={0.95} rotate={4} tails="left" />
