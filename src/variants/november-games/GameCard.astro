---
import type { CollectionEntry } from "astro:content";
import { href } from "../../lib/url";
import meta from "./meta";
import GameArtwork from "./GameArtwork.astro";

interface Props {
  game: CollectionEntry<"games">;
  index: number;
}

const { game, index } = Astro.props;
---

<article class="game-card">
  <div class="game-card-top" aria-hidden="true">
    <span>Spiel / {String(index + 1).padStart(2, "0")}</span>
    <span class="game-card-symbol">↗</span>
  </div>
  <GameArtwork game={game.id} />
  <div class="game-card-body">
    <h3>{game.data.title}</h3>
    <p class="game-tagline">{game.data.tagline}</p>
    <div class="game-card-actions">
      <a
        class="btn btn-primary"
        href={game.data.playUrl}
        aria-label={`${game.data.title} spielen`}
      >
        Spielen <span aria-hidden="true">↗</span>
      </a>
      <a
        class="text-link"
        href={href(`/${meta.slug}/spiele/${game.id}/`)}
        aria-label={`Mehr zum Spiel ${game.data.title}`}
      >
        Mehr zum Spiel <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>
