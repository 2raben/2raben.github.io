---
/**
 * Moto Devil's practice ground: a short side-view course with a ramp, spikes
 * that shoot out of the ground and a goal that drives away, as the game's text
 * describes its traps. It plays a demonstration until somebody takes over
 * with the keys from the game's controls table or the buttons below. Not the
 * game itself; motoPractice.ts runs it, and without JavaScript it stays hidden.
 */
import Paths from "./Paths.astro";
import { course } from "./motoCourse";
import * as V from "./vehicles";

const { width, height, ground } = course;
const backdrop = V.trackBackdrop(width, height, ground);
backdrop.stamp(V.loop(14), 150, ground - 36);
backdrop.stamp(V.gravestone(), 96, ground - 9);
backdrop.stamp(V.gravestone(), 146, ground - 9);
const rampPixels = V.ramp(
  course.rampEnd - course.rampStart + 1,
  course.rampHeight + 1,
);
backdrop.stamp(rampPixels, course.rampStart, ground - course.rampHeight - 1);

const sprites = {
  "es-bike-0": V.bike(0),
  "es-bike-1": V.bike(1),
  "es-jet-0": V.jet(0),
  "es-jet-1": V.jet(1),
  "es-spikes": V.spikes(
    Math.round((course.spikeTo - course.spikeFrom) / 5),
    11,
  ),
  "es-goal": V.goalFlag(),
  "es-raven": V.raven(0),
};

const keys = [
  { action: "gas", label: "W / ↑", text: "Gas" },
  { action: "brake", label: "S / ↓", text: "Bremsen" },
  { action: "back", label: "A / ←", text: "Kippen" },
  { action: "forward", label: "D / →", text: "Kippen" },
  { action: "jump", label: "Leertaste", text: "Springen, halten: Düsenschub" },
  { action: "turn", label: "E", text: "Umdrehen" },
  { action: "restart", label: "R", text: "Neustart" },
];
---

<section
  class="practice stone mt-10 p-5"
  tabindex="0"
  role="group"
  aria-labelledby="moto-practice-title"
  aria-describedby="moto-practice-help"
  data-practice="moto"
  data-label-demo="Vorführung – drück eine Taste, dann fährst du."
  data-label-manual="Du fährst."
  hidden
>
  <p class="kicker text-yolk">Übungsplatz</p>
  <h2 id="moto-practice-title" class="display text-2xl sm:text-3xl">
    Probefahrt mit Moto Devil
  </h2>
  <p id="moto-practice-help" class="mt-2">
    Eine kleine Übungsstrecke, nicht das Spiel: Klick hinein und fahr mit den
    Tasten aus dem Spiel. Kipp in der Luft für einen Salto und halt die
    Leertaste für den Düsenschub. Aber Vorsicht, die Strecke lügt.
  </p>
  <div class="frame practice-screen mt-4">
    <svg
      viewBox={`0 0 ${width} ${height}`}
      shape-rendering="crispEdges"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        {Object.entries(sprites).map(([id, pixels]) => (
          <g id={id}>
            <Paths layers={pixels.layers()} />
          </g>
        ))}
      </defs>
      <Paths layers={backdrop.layers()} />
      <g class="practice-raven">
        <use href="#es-raven" x="-20" y="10"></use>
      </g>
      <g data-goal>
        <use href="#es-goal" x={course.goal} y={ground - 18}></use>
      </g>
      <clipPath id="es-above-ground">
        <rect width={width} height={ground}></rect>
      </clipPath>
      <g clip-path="url(#es-above-ground)">
        <g data-spikes>
          <use href="#es-spikes" x={course.spikeFrom} y={ground - 11}></use>
        </g>
      </g>
      <g data-bike>
        <use href="#es-jet-0" x="-31" y="-15" data-jet></use>
        <use href="#es-bike-0" x="-17" y="-23" data-bike-sprite></use>
      </g>
    </svg>
  </div>
  <p class="mt-2 min-h-6 font-semibold">
    <span data-practice-mode></span>
    <span class="ml-2 text-yolk" data-practice-status></span>
  </p>
  <div class="mt-3 flex flex-wrap gap-2">
    {keys.map((key) => (
      <button
        type="button"
        class="practice-key"
        tabindex="-1"
        data-action={key.action}
      >
        <kbd>{key.label}</kbd> {key.text}
      </button>
    ))}
  </div>
  <p class="sr-only" aria-live="polite" data-practice-live></p>
</section>

<script>
  import "./motoPractice";
</script>
