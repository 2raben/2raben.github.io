---
/**
 * A game as a building in the settlement, in an info panel like the one a
 * strategy game shows for a selected unit: picture, name, tagline, actions.
 */
import type { CollectionEntry } from "astro:content";
import { href } from "../../lib/url";
import Building from "./Building.astro";
import { buildingFor } from "./buildings";
import meta from "./meta";

interface Props {
  game: CollectionEntry<"games">;
}

const { game } = Astro.props;
---

<article class="stone flex flex-col gap-4 p-4">
  <div class="frame building">
    <Building kind={buildingFor(game.id)} />
  </div>
  <div>
    <p class="kicker text-yolk">Gebäude</p>
    <h3 class="display text-2xl">{game.data.title}</h3>
    <p class="mt-2">{game.data.tagline}</p>
  </div>
  <div class="mt-auto flex flex-wrap gap-3">
    <a class="btn-game btn-meadow" href={game.data.playUrl}>
      Spielen
    </a>
    <a class="btn-game" href={href(`/${meta.slug}/spiele/${game.id}/`)}>
      Mehr zu {game.data.title}
    </a>
  </div>
</article>
