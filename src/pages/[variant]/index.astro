---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection } from "astro:content";
import GameCard from "../../components/GameCard.astro";
import Layout from "../../layouts/Layout.astro";
import { variants } from "../../variants";

export const getStaticPaths = (() =>
  variants.map((variant) => ({
    params: { variant: variant.slug },
    props: { variant },
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { variant } = Astro.props;
const games = (await getCollection("games")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout title={variant.name} description={variant.tagline} variant={variant}>
  <section class="hero bg-base-200 py-16">
    <div class="hero-content text-center">
      <div class="max-w-2xl">
        <h1 class="text-5xl font-bold">{variant.name}</h1>
        <p class="py-6 text-xl">{variant.tagline}</p>
        <p>
          Wir sind ein kleines Hobby-Spielestudio. Unsere Spiele laufen direkt
          im Browser, ohne Installation.
        </p>
      </div>
    </div>
  </section>
  <section id="spiele" class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="text-3xl font-bold">Unsere Spiele</h2>
    <p class="mt-2">Entstanden am Nationalen Zukunftstag 2026.</p>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {games.map((game) => (
        <GameCard game={game} variant={variant} />
      ))}
    </div>
  </section>
</Layout>
